# FloMorphic API — copy to `.env` and adjust.

# HTTP listen port (accepts "8025" or ":8025").
PORT=8025

# ---- Persistence -------------------------------------------------------------
# Repository backend: "sqlite" (the default, enough for a single-node install)
# or "postgres". The admin panel can also switch this at run time — see
# DB_CONFIG_FILE below — so these two are the deployment's default rather than
# the last word.
DB_DRIVER=sqlite
# Driver data source. For sqlite the database file path (its parent directory is
# created if missing); for postgres a connection URI, e.g.
# postgres://flo:secret@localhost:5432/flomorphic?sslmode=disable
DB_SOURCE=db/flomorphic.db

# Where a database selected in the admin panel is saved. It holds the connection
# URI (password included, so the file is written 0600) and takes precedence over
# DB_DRIVER/DB_SOURCE on the next boot; POST /database/reset deletes it. Default:
# "database.json" beside the sqlite file.
DB_CONFIG_FILE=

# Vector indexes are sqlite-vec whatever DB_DRIVER says, so this is the sqlite
# file they live in — the deployment's own file by default, which keeps existing
# vector stores searchable after a switch to postgres. Set to "off" to decline
# vector memory entirely.
DB_VECTOR_SOURCE=

# Entities a postgres deployment keeps in that sqlite file anyway, comma
# separated. "config" is the shorthand for the two credential-bearing ones (node
# settings profiles + Connect gateway tokens), so a deployment can send its
# records to postgres while its keys stay on local disk. Any of: workflows,
# contexts, memory, prompts, hitl, settings, processes, extensions, triggers,
# connect, telegram — or "all". Empty means postgres carries everything.
DB_LOCAL_TABLES=

# ---- Auth --------------------------------------------------------------------
# When true, the CRUD route groups require an HS256 bearer token. Off by default
# so the web app works standalone.
AUTH_ENABLED=false
# Secret for this API's HS256 tokens. Falls back to INFLOW_INFRA_JWT_SECRET.
API_JWT_SECRET=

# ---- Inflowenger runtime -----------------------------------------------------
# Infra API base URL and the shared JWT secret used to authenticate with it.
INFLOW_INFRA_API=
INFLOW_INFRA_JWT_SECRET=
MCP_ENABLED=1