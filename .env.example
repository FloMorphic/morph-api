# FloMorphic API — copy to `.env` and adjust.

# HTTP listen port (accepts "8025" or ":8025").
PORT=8025

# ---- Persistence -------------------------------------------------------------
# Repository backend. "sqlite" is the only driver shipped today; the repository
# layer is interface-based, so a "postgres" driver can be added without touching
# the API or controllers.
DB_DRIVER=sqlite
# Driver data source. For sqlite this is the database file path; the parent
# directory is created if missing.
DB_SOURCE=db/flomorphic.db

# ---- Auth --------------------------------------------------------------------
# When true, the CRUD route groups require an HS256 bearer token. Off by default
# so the web app works standalone.
AUTH_ENABLED=false
# Secret for this API's HS256 tokens. Falls back to INFLOW_INFRA_JWT_SECRET.
API_JWT_SECRET=

# ---- Inflowenger runtime -----------------------------------------------------
# Infra API base URL and the shared JWT secret used to authenticate with it.
INFLOW_INFRA_API=
INFLOW_INFRA_JWT_SECRET=
MCP_ENABLED=1